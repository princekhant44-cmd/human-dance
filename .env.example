# Only secrets belong in this file; every other setting is in kirak.json.
# Listed from this project's kirak.json. After enabling a module or adding a
# provider, `kirak env` shows the variables it needs.
# Fernet keys: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Database password; every other database setting is in kirak.json "database".
# DB_PASSWORD=

# Redis URL. When set, rate limiting, used one-time sign-in codes and nonces, OTP storage and model caching use Redis instead of the database.
# KIRAK_REDIS_URL=

# Signs access tokens (at least 32 bytes). Also the fallback of the other auth secrets. (required)
KIRAK_AUTH_JWT_SECRET_KEY=

# Signs refresh tokens. Default: KIRAK_AUTH_JWT_SECRET_KEY; set a separate one in production.
# KIRAK_AUTH_JWT_REFRESH_SECRET_KEY=

# Previous access-token key, during a key rotation, so tokens it signed stay valid until they expire.
# KIRAK_AUTH_JWT_OLD_SECRET_KEY=

# Previous refresh-token key, during a key rotation. Default: KIRAK_AUTH_JWT_OLD_SECRET_KEY.
# KIRAK_AUTH_JWT_REFRESH_OLD_SECRET_KEY=

# Fernet key signing email verification and password reset links, and encrypting social sign-in codes. (required)
KIRAK_AUTH_VERIFICATION_KEY=

# Comma-separated base64 keys (32 bytes each; startup refuses any other entry) encrypting social login data, MFA secrets and integration credentials. The first key encrypts; every listed key decrypts, so a new key goes first when rotating. Default: derived from KIRAK_AUTH_JWT_SECRET_KEY, with a warning; set it in production.
# KIRAK_AUTH_ENCRYPTION_KEYS=

# Keys the stored hash of API keys, so rotating KIRAK_AUTH_JWT_SECRET_KEY does not invalidate them. Default: KIRAK_AUTH_JWT_SECRET_KEY; set it in production. Setting or changing it invalidates every existing API key.
# KIRAK_AUTH_API_KEY_SECRET=
