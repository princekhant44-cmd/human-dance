        "condition": "user_id = {user_id}"
      },
      {
        "role": "admin"
      }
    ],
    "search": [
      {
        "role": "user",
        "condition": "user_id = {user_id}"
      },
      {
        "role": "admin"
      }
    ],
    "count": [
      {
        "role": "user",
        "condition": "user_id = {user_id}"
      },
      {
        "role": "admin"
      }
    ],
    "exists": [
      {
        "role": "user",
        "condition": "user_id = {user_id}"
      },
      {
        "role": "admin"
      }
    ],
    "create": [
      {
        "role": "user",
        "condition": "user_id = {user_id}"
      },
      {
        "role": "admin"
      }
    ],
    "update": [
      {
        "role": "user",
        "condition": "user_id = {user_id}"
      },
      {
        "role": "admin"
      }
    ],
    "delete": [
      {
        "role": "user",
