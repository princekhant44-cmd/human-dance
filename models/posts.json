{
  "$schema": "../.kirak/model.schema.json",
  "table": "posts",
  "soft_delete": true,
  "indexes": [
    {
      "columns": [
        "user_id"
      ]
    }
  ],
  "schema": {
    "title": {
      "type": "string",
      "required": true
    },
    "content": {
      "type": "text"
    },
    "user_id": {
      "type": "integer",
      "required": true
    }
  },
  "access": {
    "fetch": [
      {
